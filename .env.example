# RULES FOR THIS FILE: values are NEVER quoted and comments go on their own line. Docker's --env-file
# keeps quotes and trailing "# ..." as part of the value (python-dotenv strips them, Docker does not).

# ---- Chat LLM provider (commercial API; see docs/PRD_v1.2.pdf Appendix B) ----
# openai_compat  -> Google Gemini (OpenAI-compatible endpoint), Azure OpenAI / Azure AI Foundry, OpenAI,
#                   any endpoint that speaks /chat/completions (LLM_BASE_URL)
# anthropic      -> Anthropic API direct
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Main model: answering + SQL generation (deployment name on Azure). Small model: rewrite + routing.
# Free tier: gemini-3.6-flash / gemini-flash-latest allow only 20 requests/day; flash-lite is the usable one.
LLM_MODEL=gemini-3.5-flash-lite
LLM_SMALL_MODEL=gemini-3.5-flash-lite
LLM_SMALL_REASONING_EFFORT=low
# Per-request seconds and SDK retries: low, so a 429 (quota) fails fast instead of hanging.
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# Optional JSON merged into every request body (provider-specific knobs). Gemini counts thinking tokens
# against max_tokens, so keep the budget bounded. gemini-3.5-flash-lite REJECTS a budget of 0 (HTTP 400);
# 128 is the smallest tested value. Measured 2026-09-27: 128 vs 1024 differ by < 0.5 s to first token.
LLM_EXTRA_BODY={"extra_body":{"google":{"thinking_config":{"thinking_budget":128}}}}
# Empty = send no extra body for the small model (it uses LLM_SMALL_REASONING_EFFORT instead).
LLM_SMALL_EXTRA_BODY=
# OpenAI-style alternative; never combine with thinking_config:
# LLM_REASONING_EFFORT=low
# For OpenAI reasoning models (gpt-5); default is max_tokens:
# LLM_TOKENS_PARAM=max_completion_tokens
# Azure OpenAI: LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/  LLM_MODEL=<deployment name>
# Anthropic direct: LLM_PROVIDER=anthropic, LLM_API_KEY=sk-ant-..., LLM_MODEL=claude-sonnet-5, LLM_SMALL_MODEL=claude-haiku-4-5

# ---- Local models (never leave the network) ----
# Embedding backend: sentence_transformers or ollama
EMBED_BACKEND=sentence_transformers
EMBED_MODEL=BAAI/bge-m3
OLLAMA_BASE_URL=http://localhost:11434
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# torch (default) or onnx: int8 ONNX, 2.7x faster, same top result (run scripts/export_reranker_onnx.py first)
RERANK_BACKEND=onnx
# Cross-encoder window; 512 is ~4x faster than the model's 1024 on CPU
RERANK_MAX_LENGTH=512
# Texts per forward pass. Leave unset: 1 on CPU (measured ~2x faster than 32 — padding to the
# longest text dominates), 32 on a GPU.
# EMBED_BATCH_SIZE=1
# RERANK_BATCH_SIZE=1
# Torch threads for the embedder; unset = about one per physical core. The ingest scripts use
# ingest.embed_threads (4) so that the app keeps the rest of the CPU.
# EMBED_THREADS=8
# Once bge-m3 and the reranker are downloaded, 1 stops every process (app, worker) from contacting
# huggingface.co when it loads them: needed on a server without internet access, and loading is faster.
# HF_HUB_OFFLINE=1

# ---- Read-only database connections: one per catalog file (config/catalog/<db>.yaml -> connection_env) ----
# The login must have SELECT on schema rag ONLY (docs/DATA_ACCESS.md). Leave the ; { } \ unquoted.
SQLSERVER_CONN_BITOPISPLINT=Driver={ODBC Driver 18 for SQL Server};Server=<host>\<instance>;Database=BitopiSplint;UID=rag_reader;PWD=<pwd>;Encrypt=yes;TrustServerCertificate=yes;ApplicationIntent=ReadOnly
SQLSERVER_CONN_PRODUCTION=Driver={ODBC Driver 18 for SQL Server};Server=<host>\<instance>;Database=Production;UID=rag_reader;PWD=<pwd>;Encrypt=yes;TrustServerCertificate=yes;ApplicationIntent=ReadOnly
MYSQL_CONN=mysql://rag_reader:<pwd>@<host>:3306/rag

# ---- Sign-in: Active Directory (settings auth.provider: ldap) ----
# The user's own account, checked by a bind over LDAPS; their AD groups map to what they may see
# (config/scopes.yaml). No service account or password of ours is stored.
LDAP_HOST=<domain controller host>
LDAP_DOMAIN=<ad domain, e.g. bitopi.local>
LDAP_BASE_DN=<e.g. DC=bitopi,DC=local>
# LDAP_PORT=636
# true = LDAPS (636); false = StartTLS on 389. Plain LDAP is never used.
LDAP_USE_SSL=true
# CA certificate (PEM) of the domain controller if it is not in the Windows trust store
# LDAP_CA_FILE=
LDAP_TLS_VALIDATE=true

# ---- Misc ----
TESSERACT_LANGS=eng+ben
LOG_DIR=logs
