# ---- Chat LLM provider (commercial API; see docs/PRD_v1.1.pdf Appendix B) ----
# openai_compat  -> Google Gemini (OpenAI-compatible endpoint), Azure OpenAI / Azure AI Foundry, OpenAI,
#                   any endpoint that speaks /chat/completions (LLM_BASE_URL)
# anthropic      -> Anthropic API direct
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash             # answering + SQL generation (deployment name on Azure)
LLM_SMALL_MODEL=gemini-2.5-flash-lite  # rewrite + routing
LLM_TIMEOUT=30                         # per-request seconds; a 429 fails fast instead of hanging
LLM_MAX_RETRIES=2                      # SDK backoff attempts; low so quota errors surface quickly
# Optional JSON merged into every request body (provider-specific knobs). Gemini thinking budget example
# (Gemini counts thinking tokens against max_tokens, so keep the budget bounded; 0 = no thinking).
# The answer prompt is extractive (cite from sources), so 0 is a good default; raise if faithfulness drops:
LLM_EXTRA_BODY='{"extra_body":{"google":{"thinking_config":{"thinking_budget":0}}}}'
LLM_SMALL_EXTRA_BODY='{"extra_body":{"google":{"thinking_config":{"thinking_budget":0}}}}'
# LLM_REASONING_EFFORT=low                  # OpenAI-style alternative; never combine with thinking_config
# LLM_TOKENS_PARAM=max_completion_tokens    # for OpenAI reasoning models (gpt-5); default is max_tokens
# Azure OpenAI: LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/  LLM_MODEL=<deployment name>
# Anthropic direct: LLM_PROVIDER=anthropic, LLM_API_KEY=sk-ant-..., LLM_MODEL=claude-sonnet-5, LLM_SMALL_MODEL=claude-haiku-4-5

# ---- Local models (never leave the network) ----
EMBED_BACKEND=sentence_transformers   # or: ollama
EMBED_MODEL=BAAI/bge-m3
OLLAMA_BASE_URL=http://localhost:11434
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MAX_LENGTH=512                  # cross-encoder window; 512 is ~4x faster than the model's 1024 on CPU

# ---- Read-only database connections: one per catalog file (config/catalog/<db>.yaml -> connection_env) ----
# The login must have SELECT on schema rag ONLY (docs/DATA_ACCESS.md). Single-quote values that contain ; { } \
SQLSERVER_CONN_BITOPISPLINT='Driver={ODBC Driver 18 for SQL Server};Server=<host>\<instance>;Database=BitopiSplint;UID=rag_reader;PWD=<pwd>;Encrypt=yes;TrustServerCertificate=yes;ApplicationIntent=ReadOnly'
SQLSERVER_CONN_PRODUCTION='Driver={ODBC Driver 18 for SQL Server};Server=<host>\<instance>;Database=Production;UID=rag_reader;PWD=<pwd>;Encrypt=yes;TrustServerCertificate=yes;ApplicationIntent=ReadOnly'
MYSQL_CONN=mysql://rag_reader:<pwd>@<host>:3306/rag

# ---- Misc ----
TESSERACT_LANGS=eng+ben
LOG_DIR=logs
